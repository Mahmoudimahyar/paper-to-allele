{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_spec.schema.json",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "risk",
    "goal",
    "non_goals",
    "actors",
    "preconditions",
    "invariants",
    "acceptance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "ACTIVE",
        "BLOCKED",
        "BACKLOG"
      ]
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
