# secrets / local config
.env
.env.*
!.env.example
CLAUDE.local.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# agent/runtime artifacts
.artifacts/*
!.artifacts/.gitkeep
.codex-local/
.claude/local/

# sensitive project data - NEVER COMMIT
data/raw/*
data/derived/*
data/review/*
data/gold/*
!data/raw/.gitkeep
!data/golden/.gitkeep
!data/derived/.gitkeep
!data/review/.gitkeep
!data/gold/.gitkeep
!data/README.md
*.sqlite3
# `.sqlite` too, not only `.sqlite3`: every derived store this project writes
# uses that spelling, they hold report text, and the stop hook commits with
# `git add -A`. A store written outside `data/derived/` by a mistyped `--out`
# was otherwise untracked rather than ignored, which is one careless flag away
# from the sweep this file's note below already records happening once.
*.sqlite

# OCR/model/cache
.paddleocr/
.tesseract-cache/
.models/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# operator control channel (runtime only, never committed)
AGENT_STOP
STEER.md

# machine-local Claude Code overrides (never committed)
.claude/settings.local.json

# mutation testing workspace
mutants/

# Real historical archives, wherever they land. A Telegram export dropped at the
# repo root is untracked but NOT ignored, and the Stop hook runs `git add -A`,
# so without this a session ending commits real patient data.
# No trailing slash: a `dir/` pattern only matches an existing directory, so a
# zip named ChatExport_2020-01-01, or a path git has not seen yet, slipped past.
ChatExport_*
Telegram*Export*
*.tgs

# Agent worktrees the desktop app and subagents create; never part of the repo.
.claude/worktrees/
