{
  "version": 1,
  "rules": {
    "never_store_values": true,
    "doctor_must_not_echo_values": true
  },
  "items": [
    {
      "id": "LOCAL-ARCHIVE",
      "phase": "MVP-HIST",
      "env": "KM_TELEGRAM_EXPORT_DIR",
      "required": "for_real_data_only",
      "secret": false,
      "purpose": "Local extracted Telegram HTML/media directory",
      "validation": "path_exists"
    },
    {
      "id": "DATABASE",
      "phase": "MVP-HIST",
      "env": "DATABASE_URL",
      "required": "for_postgres_milestones",
      "secret": true,
      "purpose": "Local/production PostgreSQL connection",
      "validation": "nonempty"
    },
    {
      "id": "DJANGO-SECRET",
      "phase": "V3-BOT-INTAKE",
      "env": "DJANGO_SECRET_KEY",
      "required": "runtime",
      "secret": true,
      "purpose": "Django cryptographic signing",
      "validation": "nonempty"
    },
    {
      "id": "TELEGRAM-BOT",
      "phase": "V2-SYNC",
      "env": "TELEGRAM_BOT_TOKEN",
      "required": "runtime",
      "secret": true,
      "purpose": "Official Telegram bot access",
      "validation": "nonempty"
    },
    {
      "id": "TELEGRAM-WEBHOOK",
      "phase": "V2-SYNC",
      "env": "TELEGRAM_WEBHOOK_SECRET",
      "required": "runtime",
      "secret": true,
      "purpose": "Webhook authenticity secret",
      "validation": "nonempty"
    },
    {
      "id": "IDENTITY-PROVIDER",
      "phase": "V3-BOT-INTAKE",
      "env": "IDENTITY_PROVIDER_API_KEY",
      "required": "provider_integration_only",
      "secret": true,
      "purpose": "Approved Iranian identity-verification provider",
      "validation": "nonempty"
    }
  ]
}
